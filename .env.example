# The launcher loads only .env in its current working directory.
# Existing environment variables take precedence. No parent-directory search.
# Optional absolute workspace override; omit for the standard per-user data location.
# CAMPAIGN_STUDIO_DATA_DIR=/absolute/path/to/workspace
CAMPAIGN_STUDIO_PORT=8000
# Optional live generation. Leave blank for saved examples and local checks.
OPENAI_API_KEY=

# Decimal bytes: 10 GB workspace growth budget and 1 GB free-disk reserve.
CAMPAIGN_STUDIO_STORAGE_BUDGET_BYTES=10000000000
CAMPAIGN_STUDIO_DISK_RESERVE_BYTES=1000000000
